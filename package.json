{
  "name": "jev-jstris",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Jev chooses placements, Jstris plays them through real keyboard input.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/cli.js",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "verify": "npm run format:check && npm run check && npm test && npm run build",
    "format": "prettier --write src test public *.json .github/workflows",
    "format:check": "prettier --check src test public *.json .github/workflows"
  },
  "dependencies": {
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "license": "MIT"
}
